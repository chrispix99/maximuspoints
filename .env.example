# Copy to .env and fill in. NEVER commit real values.

# --- Database (Neon / Vercel Postgres) ---
# e.g. postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email magic links via Resend (https://resend.com/api-keys)
RESEND_API_KEY=
# Verified sender, e.g. "maximusPoints <login@yourdomain.com>"
EMAIL_FROM=

# --- Plaid ---
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | development | production
PLAID_ENV=sandbox

# --- Token encryption ---
# 32-byte hex string. Generate with: openssl rand -hex 32
# Used to AES-256-GCM encrypt Plaid access tokens at rest.
ENCRYPTION_KEY=
